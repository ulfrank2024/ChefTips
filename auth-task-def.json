
{
    "family": "auth-service-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::946358504020:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::946358504020:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "auth-service",
            "image": "946358504020.dkr.ecr.us-east-1.amazonaws.com/auth-service:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                { "name": "DATABASE_URL", "value": "postgres://tips_ulrich_2025:123qweJesus@auth-db-instance.cgt80m8q6ayi.us-east-1.rds.amazonaws.com:5432/auth_service_db?ssl=true" },
                { "name": "NODE_ENV", "value": "production" },
                { "name": "JWT_SECRET", "value": "a-very-secret-and-long-key-for-dev-only-!@#$%" },
                { "name": "SES_FROM_EMAIL", "value": "noreply@cheftips.app" },
                { "name": "AWS_REGION", "value": "us-east-1" },
                { "name": "FRONTEND_URL", "value": "https://www.cheftips.app/" },
                { "name": "BILLING_SERVICE_URL", "value": "http://54.167.122.141:4002/api/billing" },
                { "name": "NODE_TLS_REJECT_UNAUTHORIZED", "value": "0" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/auth-service",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
