<div style="font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; margin: auto; background-color: #ffffff; border-radius: 8px; overflow: hidden;">
        <tr>
            <td style="background-color: #007bff; padding: 20px; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">ChefTips</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 20px;">
                <!-- French Content -->
                <h2 style="font-size: 20px; color: #333;">{{fr.title}}</h2>
                <p style="font-size: 16px; color: #333;">{{fr.body}}</p>
                <div style="text-align: center; margin: 20px 0;">
                    <a href="{{setupLink}}" style="background-color: #007bff; color: #ffffff; padding: 12px 25px; text-decoration: none; border-radius: 5px; display: inline-block; font-size: 16px;">{{fr.button}}</a>
                </div>

                <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">

                <!-- English Content -->
                <h2 style="font-size: 20px; color: #333;">{{en.title}}</h2>
                <p style="font-size: 16px; color: #333;">{{en.body}}</p>
                <div style="text-align: center; margin: 20px 0;">
                    <a href="{{setupLink}}" style="background-color: #007bff; color: #ffffff; padding: 12px 25px; text-decoration: none; border-radius: 5px; display: inline-block; font-size: 16px;">{{en.button}}</a>
                </div>
            </td>
        </tr>
        <tr>
            <td style="background-color: #f4f4f4; padding: 20px; text-align: center; font-size: 12px; color: #999;">
                <p>&copy; {{currentYear}} ChefTips. All rights reserved.</p>
            </td>
        </tr>
    </table>
</div>
