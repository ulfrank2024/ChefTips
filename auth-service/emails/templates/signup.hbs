<div style="font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; margin: auto; background-color: #ffffff; border-radius: 8px; overflow: hidden;">
        <tr>
            <td style="background-color: #007bff; padding: 20px; text-align: center;">
                <h1 style="color: #ffffff; margin: 0;">ChefTips</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 20px;">
                <!-- French Content -->
                <p style="font-size: 16px; color: #333;">{{fr.greeting}}</p>
                <p style="font-size: 16px; color: #333;">{{fr.body1}}</p>
                <div style="text-align: center; margin: 30px 0;">
                    <p style="font-size: 24px; font-weight: bold; letter-spacing: 3px; color: #007bff; background-color: #e9f5ff; padding: 15px 25px; border-radius: 5px; display: inline-block;">{{otp}}</p>
                </div>
                <p style="font-size: 14px; color: #666;">{{fr.body2}}</p>
                <p style="font-size: 16px; color: #333;">{{fr.closing}}</p>
                <p style="font-size: 16px; color: #333;">{{fr.teamName}}</p>

                <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">

                <!-- English Content -->
                <p style="font-size: 14px; color: #999; text-align: center;">{{en.bilingual_intro}}</p>
                <p style="font-size: 16px; color: #333;">{{en.greeting}}</p>
                <p style="font-size: 16px; color: #333;">{{en.body1}}</p>
                <div style="text-align: center; margin: 30px 0;">
                    <p style="font-size: 24px; font-weight: bold; letter-spacing: 3px; color: #007bff; background-color: #e9f5ff; padding: 15px 25px; border-radius: 5px; display: inline-block;">{{otp}}</p>
                </div>
                <p style="font-size: 14px; color: #666;">{{en.body2}}</p>
                <p style="font-size: 16px; color: #333;">{{en.closing}}</p>
                <p style="font-size: 16px; color: #333;">{{en.teamName}}</p>
            </td>
        </tr>
        <tr>
            <td style="background-color: #f4f4f4; padding: 20px; text-align: center; font-size: 12px; color: #999;">
                <p>&copy; {{currentYear}} ChefTips. All rights reserved.</p>
            </td>
        </tr>
    </table>
</div>